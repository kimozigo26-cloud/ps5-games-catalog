        const STORAGE_KEY = 'prof_center_ps5_games_v2';
        const ADMIN_PASS = 'Kemo3020';

        let gamesList = [];
        let isAdmin = false;
        let currentView = 'table';
        let sortAsc = true;

        // On Page Load
        window.onload = function() {
            initApp();
        };

        function initApp() {
            loadFromStorage();
            calculateStorage();
            render();
        }

        function loadFromStorage() {
            try {
                const stored = localStorage.getItem(STORAGE_KEY);
                if (stored) {
                    gamesList = JSON.parse(stored);
                } else {
                    gamesList = [...initial65Games];
                    saveToStorage();
                }
            } catch (err) {
                console.error("Storage error:", err);
                gamesList = [...initial65Games];
            }
            sortAlphabetically();
        }

        function saveToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(gamesList));
            } catch (err) {
                showToast("حدث خطأ أثناء حفظ البيانات في ذاكرة المتصفح!", "error");
            }
        }

        function calculateStorage() {
            let totalGB = 0;
            gamesList.forEach(game => {
                if (game.size) {
                    if (game.size.toLowerCase().includes('gb')) {
                        const num = parseFloat(game.size);
                        if (!isNaN(num)) totalGB += num;
                    } else if (game.size.toLowerCase().includes('mb')) {
                        const num = parseFloat(game.size);
                        if (!isNaN(num)) totalGB += (num / 1024);
                    }
                }
            });
            document.getElementById('statTotalStorage').textContent = totalGB.toFixed(1) + " GB";
            document.getElementById('statTotalGames').textContent = gamesList.length;
        }

        function sortAlphabetically() {
            gamesList.sort((a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base' }));
        }

        // Admin Toggle Handler
        function toggleAdminPrompt() {
            if (!isAdmin) {
                const pass = prompt("رجاءً أدخل كلمة السر للدخول لوحة التحكم:");
                if (pass === ADMIN_PASS) {
                    isAdmin = true;
                    updateAdminUI();
                    showToast("تم فتح صلاحيات الإدارة بنجاح!", "success");
                } else if (pass !== null) {
                    showToast("كلمة السر غير صحيحة!", "error");
                }
            } else {
                isAdmin = false;
                updateAdminUI();
                showToast("تم الخروج من وضع الإدارة", "info");
            }
        }

        function updateAdminUI() {
            const adminPanel = document.getElementById('adminPanel');
            const adminLockIcon = document.getElementById('adminLockIcon');
            const adminBtnText = document.getElementById('adminBtnText');
            const adminCols = document.querySelectorAll('.admin-col');

            if (isAdmin) {
                adminPanel.classList.remove('hidden');
                adminLockIcon.className = "fa-solid fa-lock-open text-psEmerald";
                adminBtnText.textContent = "خروج من الإدارة";
                adminCols.forEach(c => c.classList.remove('hidden'));
            } else {
                adminPanel.classList.add('hidden');
                adminLockIcon.className = "fa-solid fa-lock text-psGold";
                adminBtnText.textContent = "دخول لوحة التحكم";
                adminCols.forEach(c => c.classList.add('hidden'));
            }
            render();
        }

        function switchView(view) {
            currentView = view;
            const tableView = document.getElementById('tableView');
            const gridView = document.getElementById('gridView');
            const tableViewBtn = document.getElementById('tableViewBtn');
            const gridViewBtn = document.getElementById('gridViewBtn');

            if (view === 'table') {
                tableView.classList.remove('hidden');
                gridView.classList.add('hidden');
                tableViewBtn.className = "px-3.5 py-2 rounded-lg bg-psBlue text-white transition text-xs font-bold flex items-center gap-1.5 shadow";
                gridViewBtn.className = "px-3.5 py-2 rounded-lg text-slate-400 hover:text-white transition text-xs font-bold flex items-center gap-1.5";
            } else {
                tableView.classList.add('hidden');
                gridView.classList.remove('hidden');
                gridViewBtn.className = "px-3.5 py-2 rounded-lg bg-psBlue text-white transition text-xs font-bold flex items-center gap-1.5 shadow";
                tableViewBtn.className = "px-3.5 py-2 rounded-lg text-slate-400 hover:text-white transition text-xs font-bold flex items-center gap-1.5";
            }
        }

        // Render Functions
        function render(data = gamesList) {
            const tableBody = document.getElementById('gamesTableBody');
            const gridView = document.getElementById('gridView');
            const emptyMsg = document.getElementById('emptyMessage');

            tableBody.innerHTML = '';
            gridView.innerHTML = '';

            if (data.length === 0) {
                emptyMsg.classList.remove('hidden');
                return;
            } else {
                emptyMsg.classList.add('hidden');
            }

            data.forEach((game, index) => {
                const placeholder = `https://via.placeholder.com/300x400/131e3a/00d4ff?text=${encodeURIComponent(game.title)}`;
                const imgSrc = (game.image && game.image.trim() !== '') ? game.image : placeholder;

                // 1. Table Row
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/50 transition border-b border-slate-800/80";
                tr.innerHTML = `
                    <td class="p-3.5 text-center font-bold text-slate-400">${index + 1}</td>
                    <td class="p-2 text-center">
                        <img src="${imgSrc}" onerror="this.src='${placeholder}'" alt="${game.title}" class="w-10 h-12 object-cover rounded-md shadow border border-slate-700 mx-auto">
                    </td>
                    <td class="p-3.5 font-bold text-white text-sm sm:text-base">${game.title}</td>
                    <td class="p-3.5 text-center">
                        <span class="inline-block badge-cyan px-2.5 py-1 rounded-full text-xs font-bold">
                            ${game.size}
                        </span>
                    </td>
                    <td class="p-3.5 text-center font-mono text-slate-300 text-xs">${game.code || '-'}</td>
                    <td class="p-3.5 text-center font-bold text-psEmerald">${game.price || '-'}</td>
                    <td class="p-3.5 text-slate-400 text-xs">${game.notes || '-'}</td>
                    <td class="p-3.5 text-center admin-col ${isAdmin ? '' : 'hidden'}">
                        <div class="flex items-center justify-center gap-1.5">
                            <button onclick="editGame(${game.id})" class="w-7 h-7 rounded-lg bg-psGold/20 text-psGold hover:bg-psGold hover:text-black transition flex items-center justify-center text-xs" title="تعديل">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button onclick="deleteGame(${game.id})" class="w-7 h-7 rounded-lg bg-psRose/20 text-psRose hover:bg-psRose hover:text-white transition flex items-center justify-center text-xs" title="حذف">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                tableBody.appendChild(tr);

                // 2. Grid Card
                const card = document.createElement('div');
                card.className = "glass-card rounded-2xl overflow-hidden border border-slate-800 shadow-xl flex flex-col justify-between group ps-glow-hover transition-all duration-300";
                card.innerHTML = `
                    <div class="relative overflow-hidden aspect-[3/4] bg-slate-950">
                        <img src="${imgSrc}" onerror="this.src='${placeholder}'" alt="${game.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute top-3 right-3 bg-psBg/80 backdrop-blur-md text-psCyan px-3 py-1 rounded-full text-xs font-extrabold border border-psCyan/30">
                            ${game.size}
                        </div>
                        ${isAdmin ? `
                        <div class="absolute top-3 left-3 flex gap-1">
                            <button onclick="editGame(${game.id})" class="w-8 h-8 rounded-lg bg-slate-900/90 text-psGold hover:bg-psGold hover:text-black transition flex items-center justify-center text-xs shadow-lg">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button onclick="deleteGame(${game.id})" class="w-8 h-8 rounded-lg bg-slate-900/90 text-psRose hover:bg-psRose hover:text-white transition flex items-center justify-center text-xs shadow-lg">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                        ` : ''}
                    </div>
                    <div class="p-4 flex-grow flex flex-col justify-between">
                        <div>
                            <h4 class="font-extrabold text-white text-sm sm:text-base mb-1.5 group-hover:text-psCyan transition line-clamp-1">${game.title}</h4>
                            <p class="text-xs font-mono text-slate-400 mb-2"><i class="fa-solid fa-barcode text-psBrightBlue ml-1"></i> ${game.code || 'بلا كود'}</p>
                            ${game.notes ? `<p class="text-xs text-slate-400 bg-slate-900/60 p-2 rounded-lg border border-slate-800 mb-3">${game.notes}</p>` : ''}
                        </div>
                        <div class="flex items-center justify-between pt-2 border-t border-slate-800 text-xs font-bold">
                            <span class="text-slate-400">السعر: <strong class="text-psEmerald">${game.price || 'غير محدد'}</strong></span>
                            <span class="text-slate-500">#${index + 1}</span>
                        </div>
                    </div>
                `;
                gridView.appendChild(card);
            });
        }

        // Live Search Handler
        function handleSearch() {
            const query = document.getElementById('searchInput').value.trim().toLowerCase();
            const clearBtn = document.getElementById('clearSearchBtn');

            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }

            const filtered = gamesList.filter(g => 
                g.title.toLowerCase().includes(query) ||
                (g.code && g.code.toLowerCase().includes(query)) ||
                (g.size && g.size.toLowerCase().includes(query))
            );

            render(filtered);
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearchBtn').classList.add('hidden');
            render(gamesList);
        }

        function sortData(key) {
            sortAsc = !sortAsc;
            gamesList.sort((a, b) => {
                let valA = a[key] ? a[key].toString().toLowerCase() : '';
                let valB = b[key] ? b[key].toString().toLowerCase() : '';
                return sortAsc ? valA.localeCompare(valB, 'ar') : valB.localeCompare(valA, 'ar');
            });
            saveToStorage();
            render();
            showToast(`تم ترتيب البيانات حسب ${key === 'title' ? 'الاسم' : 'المساحة'}`, "info");
        }

        // Form Submission
        function handleFormSubmit(e) {
            e.preventDefault();

            const editId = document.getElementById('editGameId').value;
            const title = document.getElementById('gameTitle').value.trim();
            const size = document.getElementById('gameSize').value.trim();
            const code = document.getElementById('gameCode').value.trim();
            const price = document.getElementById('gamePrice').value.trim();
            const image = document.getElementById('gameImage').value.trim();
            const notes = document.getElementById('gameNotes').value.trim();

            if (editId !== '') {
                const idx = gamesList.findIndex(g => Number(g.id) === Number(editId));
                if (idx !== -1) {
                    gamesList[idx] = { ...gamesList[idx], title, size, code, price, image, notes };
                    showToast("تم تحديث معلومات اللعبة بنجاح!", "success");
                }
            } else {
                const newGame = {
                    id: Date.now(),
                    title,
                    size,
                    code,
                    price,
                    image,
                    notes
                };
                gamesList.push(newGame);
                showToast("تمت إضافة اللعبة بنجاح إلى المكتبة!", "success");
            }

            sortAlphabetically();
            saveToStorage();
            calculateStorage();
            render();
            resetForm();
        }

        function editGame(id) {
            const game = gamesList.find(g => Number(g.id) === Number(id));
            if (!game) return;

            document.getElementById('editGameId').value = game.id;
            document.getElementById('gameTitle').value = game.title;
            document.getElementById('gameSize').value = game.size;
            document.getElementById('gameCode').value = game.code || '';
            document.getElementById('gamePrice').value = game.price || '';
            document.getElementById('gameImage').value = game.image || '';
            document.getElementById('gameNotes').value = game.notes || '';

            document.getElementById('adminFormTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-psGold"></i> تعديل بيانات لعبة (${game.title})`;
            document.getElementById('saveBtn').innerHTML = `<i class="fa-solid fa-arrows-rotate"></i> تحديث وحفظ اللعبة`;

            window.scrollTo({ top: 120, behavior: 'smooth' });
        }

        function deleteGame(id) {
            const game = gamesList.find(g => Number(g.id) === Number(id));
            if (confirm(`هل أنت تأكد من حذف لعبة (${game ? game.title : ''})؟`)) {
                gamesList = gamesList.filter(g => Number(g.id) !== Number(id));
                saveToStorage();
                calculateStorage();
                render();
                showToast("تم حذف اللعبة بنجاح", "info");
            }
        }

        function resetForm() {
            document.getElementById('gameForm').reset();
            document.getElementById('editGameId').value = '';
            document.getElementById('adminFormTitle').innerHTML = `<i class="fa-solid fa-plus-circle"></i> إضافة لعبة جديدة للقائمة`;
            document.getElementById('saveBtn').innerHTML = `<i class="fa-solid fa-floppy-disk"></i> حفظ البيانات`;
        }

        function restoreDefaultGames() {
            if (confirm("هل أنت تأكد من استعادة الـ 65 لعبة الأصلية؟ سيتم إلغاء أي تعديلات أو إضافات جديدة.")) {
                gamesList = [...initial65Games];
                saveToStorage();
                calculateStorage();
                sortAlphabetically();
                render();
                showToast("تمت استعادة الـ 65 لعبة الأصلية بنجاح!", "success");
            }
        }

        function backupJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(gamesList, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "professor_center_ps5_games.json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast("تم استخراج النسخة الاحتياطية JSON", "success");
        }

        function exportExcel() {
            const exportData = gamesList.map((g, idx) => ({
                "م": idx + 1,
                "اسم اللعبة (Game Title)": g.title,
                "المساحة التخزينية": g.size,
                "كود اللعبة (Game ID)": g.code || '-',
                "السعر": g.price || '-',
                "الملاحظات": g.notes || '-'
            }));

            const ws = XLSX.utils.json_to_sheet(exportData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "قائمة الألعاب");
            XLSX.writeFile(wb, "قائمة_ألعاب_PS5_مركز_البروفسير.xlsx");
            showToast("تم تصدير ملف Excel بنجاح!", "success");
        }

        function showToast(msg, type = "info") {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');

            let bgClass = "bg-slate-800 border-slate-700 text-white";
            let icon = "fa-circle-info text-psCyan";

            if (type === "success") {
                bgClass = "bg-emerald-950/90 border-emerald-600 text-emerald-200";
                icon = "fa-circle-check text-emerald-400";
            } else if (type === "error") {
                bgClass = "bg-rose-950/90 border-rose-600 text-rose-200";
                icon = "fa-circle-exclamation text-rose-400";
            }

            toast.className = `flex items-center gap-3 px-4 py-3 rounded-xl border shadow-2xl text-xs sm:text-sm font-bold transition-all duration-300 transform translate-y-2 opacity-0 ${bgClass}`;
            toast.innerHTML = `<i class="fa-solid ${icon} text-base"></i> <span>${msg}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
