    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        psBg: '#080d1a',
                        psNavy: '#0f172a',
                        psCard: '#131e3a',
                        psBlue: '#00439c',
                        psBrightBlue: '#0070d1',
                        psCyan: '#00d4ff',
                        psGold: '#ffb703',
                        psEmerald: '#10b981',
                        psRose: '#f43f5e'
                    },
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                        tajawal: ['Tajawal', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #080d1a;
            color: #f1f5f9;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(0, 67, 156, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(0, 212, 255, 0.1) 0%, transparent 40%);
            background-attachment: fixed;
        }

        .glass-card {
            background: rgba(19, 30, 58, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-header {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 212, 255, 0.15);
        }

        .ps-glow {
            box-shadow: 0 0 25px rgba(0, 212, 255, 0.25);
        }

        .ps-glow-hover:hover {
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.45);
            border-color: rgba(0, 212, 255, 0.4);
        }

        .badge-cyan {
            background: rgba(0, 212, 255, 0.12);
            color: #00d4ff;
            border: 1px solid rgba(0, 212, 255, 0.3);
        }

        .badge-gold {
            background: rgba(255, 183, 3, 0.12);
            color: #ffb703;
            border: 1px solid rgba(255, 183, 3, 0.3);
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #080d1a;
        }
        ::-webkit-scrollbar-thumb {
            background: #00439c;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0070d1;
        }

        @media print {
            .no-print, header, .controls-bar, #adminPanel, footer, .toast-container {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            .glass-card {
                background: white !important;
                border: none !important;
                box-shadow: none !important;
            }
            table {
                width: 100% !important;
                color: black !important;
                border-collapse: collapse !important;
            }
            th, td {
                border: 1px solid #cbd5e1 !important;
                color: black !important;
                padding: 8px !important;
            }
            thead {
                background-color: #00439c !important;
                color: white !important;
                -webkit-print-color-adjust: exact;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-psCyan selection:text-psBg">

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed bottom-5 left-5 z-50 flex flex-col gap-2 no-print"></div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 glass-header shadow-2xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- Logo & Branding -->
                <div class="flex items-center gap-3 sm:gap-4">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-psBlue via-psBrightBlue to-psCyan flex items-center justify-center text-white text-2xl font-black shadow-lg ps-glow">
                        <i class="fa-brands fa-playstation"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-lg sm:text-2xl font-black text-white tracking-wide">مركز البروفسير</h1>
                            <span class="text-[10px] sm:text-xs bg-psBlue/60 text-psCyan px-2.5 py-0.5 rounded-full border border-psCyan/30 font-bold hidden sm:inline-block">PS5 Jailbreak Catalog</span>
                        </div>
                        <p class="text-xs text-slate-400 font-tajawal">قائمة ألعاب PlayStation 5 المعتمدة والمعدلة</p>
                    </div>
                </div>

                <!-- Admin Action Button -->
                <div class="flex items-center gap-3">
                    <button id="adminToggleBtn" onclick="toggleAdminPrompt()" class="flex items-center gap-2 bg-slate-800/90 hover:bg-slate-700 text-slate-200 px-4 py-2.5 rounded-xl border border-slate-700 transition-all text-xs sm:text-sm font-bold shadow-lg hover:border-psCyan">
                        <i class="fa-solid fa-lock text-psGold" id="adminLockIcon"></i>
                        <span id="adminBtnText">دخول لوحة التحكم</span>
                    </button>
                </div>

            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

        <!-- Top KPI Metrics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8 no-print">
            <div class="glass-card rounded-2xl p-4 flex items-center gap-4 border border-slate-800 hover:border-psBlue/60 transition">
                <div class="w-12 h-12 rounded-xl bg-psBlue/30 text-psCyan flex items-center justify-center text-xl font-bold border border-psBlue/40">
                    <i class="fa-solid fa-gamepad"></i>
                </div>
                <div>
                    <span class="text-xs text-slate-400 font-bold block mb-0.5">إجمالي الألعاب بالمكتبة</span>
                    <h3 id="statTotalGames" class="text-2xl font-black text-white leading-none">65</h3>
                </div>
            </div>

            <div class="glass-card rounded-2xl p-4 flex items-center gap-4 border border-slate-800 hover:border-psBlue/60 transition">
                <div class="w-12 h-12 rounded-xl bg-psGold/20 text-psGold flex items-center justify-center text-xl font-bold border border-psGold/30">
                    <i class="fa-solid fa-hard-drive"></i>
                </div>
                <div>
                    <span class="text-xs text-slate-400 font-bold block mb-0.5">إجمالي السعة التخزينية</span>
                    <h3 id="statTotalStorage" class="text-2xl font-black text-white leading-none">0 GB</h3>
                </div>
            </div>

            <div class="glass-card rounded-2xl p-4 flex items-center gap-4 border border-slate-800 hover:border-psBlue/60 transition sm:col-span-2 lg:col-span-1">
                <div class="w-12 h-12 rounded-xl bg-psEmerald/20 text-psEmerald flex items-center justify-center text-xl font-bold border border-psEmerald/30">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <span class="text-xs text-slate-400 font-bold block mb-0.5">حالة النظام والجاهزية</span>
                    <h3 id="statStatusText" class="text-base font-extrabold text-psEmerald leading-snug">مُحدث ومزامن تلقائياً</h3>
                </div>
            </div>
        </div>

        <!-- Controls Bar -->
        <div class="controls-bar glass-card rounded-2xl p-4 sm:p-5 mb-8 shadow-xl border border-slate-800">
            <div class="flex flex-col lg:flex-row items-center justify-between gap-4">
                
                <!-- Live Search -->
                <div class="relative w-full lg:w-1/2">
                    <i class="fa-solid fa-magnifying-glass absolute right-4 top-1/2 -translate-y-1/2 text-psCyan text-base"></i>
                    <input type="text" id="searchInput" oninput="handleSearch()" placeholder="ابحث باسم اللعبة، كود PPSA، أو المساحة..." class="w-full bg-slate-900/90 text-white placeholder-slate-400 pr-11 pl-10 py-3 rounded-xl border border-slate-700/80 focus:outline-none focus:border-psCyan focus:ring-1 focus:ring-psCyan text-sm transition font-tajawal shadow-inner">
                    <button id="clearSearchBtn" onclick="clearSearch()" class="hidden absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition text-xs bg-slate-800 px-2 py-1 rounded-md">
                        مسح
                    </button>
                </div>

                <!-- Action Buttons & Layout Switches -->
                <div class="flex flex-wrap items-center justify-between lg:justify-end w-full lg:w-auto gap-2.5">
                    
                    <!-- Excel Export -->
                    <button onclick="exportExcel()" class="bg-emerald-600/90 hover:bg-emerald-500 text-white px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition shadow-md border border-emerald-500/30">
                        <i class="fa-solid fa-file-excel text-base"></i>
                        <span>تصدير Excel</span>
                    </button>

                    <!-- Print / PDF -->
                    <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-700 text-white px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition shadow-md border border-slate-700">
                        <i class="fa-solid fa-print text-base"></i>
                        <span>طباعة / PDF</span>
                    </button>

                    <!-- View Mode Switcher -->
                    <div class="flex bg-slate-900/90 p-1 rounded-xl border border-slate-800">
                        <button id="tableViewBtn" onclick="switchView('table')" class="px-3.5 py-2 rounded-lg bg-psBlue text-white transition text-xs font-bold flex items-center gap-1.5 shadow">
                            <i class="fa-solid fa-list"></i>
                            <span class="hidden sm:inline">جدول</span>
                        </button>
                        <button id="gridViewBtn" onclick="switchView('grid')" class="px-3.5 py-2 rounded-lg text-slate-400 hover:text-white transition text-xs font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-grip"></i>
                            <span class="hidden sm:inline">شبكي</span>
                        </button>
                    </div>

                </div>

            </div>
        </div>

        <!-- Admin Management Panel (Protected) -->
        <div id="adminPanel" class="hidden mb-8 glass-card rounded-2xl p-6 border-2 border-psCyan/40 shadow-2xl bg-gradient-to-b from-psCard to-psBg relative overflow-hidden">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-800">
                <h3 id="adminFormTitle" class="text-lg sm:text-xl font-black text-psCyan flex items-center gap-2">
                    <i class="fa-solid fa-plus-circle"></i> إضافة لعبة جديدة للقائمة
                </h3>
                
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="backupJSON()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-download"></i> تصدير JSON
                    </button>
                    <button onclick="restoreDefaultGames()" class="bg-rose-950/60 hover:bg-rose-900 text-rose-300 border border-rose-800/60 px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-rotate-left"></i> استعادة الـ 65 لعبة الأصلية
                    </button>
                </div>
            </div>

            <!-- Form -->
            <form id="gameForm" onsubmit="handleFormSubmit(event)" class="space-y-4">
                <input type="hidden" id="editGameId">

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs text-slate-300 mb-1 font-bold">اسم اللعبة *</label>
                        <input type="text" id="gameTitle" required placeholder="مثال: ASTRO BOT (PS5)" class="w-full bg-slate-900 text-white px-3.5 py-2.5 rounded-xl border border-slate-700 text-xs sm:text-sm focus:border-psCyan focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs text-slate-300 mb-1 font-bold">المساحة التخزينية *</label>
                        <input type="text" id="gameSize" required placeholder="مثال: 50.0 GB" class="w-full bg-slate-900 text-white px-3.5 py-2.5 rounded-xl border border-slate-700 text-xs sm:text-sm focus:border-psCyan focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs text-slate-300 mb-1 font-bold">كود اللعبة (PPSA)</label>
                        <input type="text" id="gameCode" placeholder="مثال: PPSA07570" class="w-full bg-slate-900 text-white px-3.5 py-2.5 rounded-xl border border-slate-700 text-xs sm:text-sm focus:border-psCyan focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs text-slate-300 mb-1 font-bold">السعر (اختياري)</label>
                        <input type="text" id="gamePrice" placeholder="مثال: 150 ج.م" class="w-full bg-slate-900 text-white px-3.5 py-2.5 rounded-xl border border-slate-700 text-xs sm:text-sm focus:border-psCyan focus:outline-none">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs text-slate-300 mb-1 font-bold">رابط صورة الغلاف (URL Image)</label>
                        <input type="url" id="gameImage" placeholder="https://example.com/cover.jpg" class="w-full bg-slate-900 text-white px-3.5 py-2.5 rounded-xl border border-slate-700 text-xs sm:text-sm focus:border-psCyan focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs text-slate-300 mb-1 font-bold">ملاحظات إضافية</label>
                    <input type="text" id="gameNotes" placeholder="مثال: باللغة العربية بملف التحديث الأخير" class="w-full bg-slate-900 text-white px-3.5 py-2.5 rounded-xl border border-slate-700 text-xs sm:text-sm focus:border-psCyan focus:outline-none">
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" id="saveBtn" class="bg-gradient-to-r from-psBlue to-psBrightBlue hover:from-blue-600 hover:to-blue-400 text-white font-black px-6 py-2.5 rounded-xl text-xs sm:text-sm transition shadow-lg flex items-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i> حفظ البيانات
                    </button>
                    <button type="button" onclick="resetForm()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition">
                        إلغاء / إعادة ضبط
                    </button>
                </div>
            </form>
        </div>

        <!-- Display View 1: Interactive Table -->
        <div id="tableView" class="glass-card rounded-2xl overflow-hidden shadow-2xl border border-slate-800">
            <div class="overflow-x-auto">
                <table class="w-full text-right text-xs sm:text-sm">
                    <thead class="bg-gradient-to-r from-psBlue to-psNavy text-white font-black border-b border-slate-800">
                        <tr>
                            <th class="p-3.5 text-center w-12">م</th>
                            <th class="p-3.5 text-center w-16">الغلاف</th>
                            <th class="p-3.5 cursor-pointer hover:text-psCyan transition" onclick="sortData('title')">
                                اسم اللعبة (Game Title) <i class="fa-solid fa-sort text-[10px] opacity-60"></i>
                            </th>
                            <th class="p-3.5 text-center cursor-pointer hover:text-psCyan transition" onclick="sortData('size')">
                                المساحة <i class="fa-solid fa-sort text-[10px] opacity-60"></i>
                            </th>
                            <th class="p-3.5 text-center">كود اللعبة (Game ID)</th>
                            <th class="p-3.5 text-center">السعر</th>
                            <th class="p-3.5">ملاحظات</th>
                            <th class="p-3.5 text-center admin-col hidden w-24">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="gamesTableBody" class="divide-y divide-slate-800/80 text-slate-200">
                        <!-- Dynamic Rows -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Display View 2: Cards Grid -->
        <div id="gridView" class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
            <!-- Dynamic Cards -->
        </div>

        <!-- Empty Results Message -->
        <div id="emptyMessage" class="hidden text-center py-16 glass-card rounded-2xl my-6 border border-slate-800">
            <i class="fa-solid fa-ghost text-5xl text-slate-600 mb-3"></i>
            <h4 class="text-base font-bold text-slate-300">لم يتم العثور على ألعاب مطابقة للمحرك!</h4>
            <p class="text-xs text-slate-500 mt-1">جرّب البحث باسم آخر أو بمحيط كود اللعبة.</p>
        </div>

    </main>

    <!-- Footer -->
    <footer class="glass-card border-t border-slate-800 mt-12 py-6 text-center text-slate-400 text-xs no-print">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
            <p>© 2026 جميع الحقوق محفوظة لـ <span class="text-psCyan font-extrabold">مركز البروفسير</span></p>
            <p class="text-slate-500 font-tajawal">نظام كتالوج ألعاب PlayStation 5 التفاعلي الذكي</p>
        </div>
    </footer>

